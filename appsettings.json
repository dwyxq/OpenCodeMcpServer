{
  // ===== 模型发现配置 =====
  "ModelDiscovery": {
    "Enabled": true,
    "EnabledSources": [
      "HuggingFace",
      "Ollama",
      "OpenRouter",
      "Custom"
    ],
    "RefreshIntervalHours": 3, // 定时刷新周期（小时）
    "RefreshOnStartup": true,
    "WarmupDelaySeconds": 5,
    "MaxModelsPerSource": 100,
    "AutoUpdate": true,
    "CacheDirectory": "./cache/models",
    "CacheTtlMinutes": 30,
    // ===== 模型发现健康检查配置 默认 6，0 禁用 =====
    "HealthProbeIntervalHours": 6
  },

  // ===== 各提供商 API 配置 =====
  "ProviderEndpoints": {
    // HuggingFace - 免费模型浏览，无需 Key；HF_TOKEN 用于访问私有模型或提高速率限制
    "HuggingFace": {
      "BaseUrl": "https://huggingface.co/api",
      "ApiKeyEnvVar": "HF_TOKEN",
      "TimeoutSeconds": 30,
      "Enabled": true
    },

    // Ollama - 本地运行时默认 localhost:11434；如需远程服务器请修改 BaseUrl
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "LibraryBaseUrl": "https://ollama.com/library",
      "TimeoutSeconds": 30,
      "Enabled": true
    },

    // OpenRouter - 可选 API Key，部分免费模型无需 Key
    "OpenRouter": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "ApiKeyEnvVar": "OPENROUTER_API_KEY",
      "TimeoutSeconds": 30,
      "Enabled": true
    },

    // TogetherAI - 可选，提供大量免费模型
    "TogetherAi": {
      "BaseUrl": "https://api.together.xyz",
      "ApiKeyEnvVar": "TOGETHER_API_KEY",
      "TimeoutSeconds": 30,
      "Enabled": false
    },

    // Groq - 可选，高速推理
    "Groq": {
      "BaseUrl": "https://api.groq.com/openai/v1",
      "ApiKeyEnvVar": "GROQ_API_KEY",
      "TimeoutSeconds": 30,
      "Enabled": false
    },

    // ===== 自定义 OpenAI 兼容提供商（代理 / 模型目录 / 自动优化的统一配置源）=====
    // 密钥一律经 ApiKeys:CustomProviders 或 ApiKeyEnvVar 指定环境变量注入，禁止写明文
    // Models 为静态目录（提供商 /models 端点不可用时的回退列表）
    "CustomProviders": {
      "agnes-ai-cn": {
        "BaseUrl": "https://api.agnes-ai.cn/v1",
        "ApiKeyEnvVar": "AGNES_CN_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "agnes-2.5-pro", "agnes-2.5-flash" ],
        // 分组标签：高能力组、推理组、文案组
        "Groups": [ "高能力组", "推理组", "文案组" ]
      },
      "agnes-ai": {
        "BaseUrl": "https://apihub.agnes-ai.com/v1",
        "ApiKeyEnvVar": "AGNES_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "agnes-2.5-flash", "agnes-2.0-flash" ],
        // 分组标签：均衡组、推理组
        "Groups": [ "均衡组", "推理组" ]
      },
      "stepfun": {
        "BaseUrl": "https://api.stepfun.com/step_plan/v1",
        "ApiKeyEnvVar": "STEPFUN_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "step-router-v1", "step-3.7-flash" ],
        // 分组标签：高能力组、推理组、代码组
        "Groups": [ "高能力组", "推理组", "代码组" ]
      },
      "sensenova": {
        "BaseUrl": "https://token.sensenova.cn/v1",
        "ApiKeyEnvVar": "SENSONOVA_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "kimi-k3", "glm-5.2", "deepseek-v4-pro", "deepseek-v4-flash", "sensenova-6.8-flash-lite" ],
        "Capabilities": {
          "deepseek-v4-flash": [ "vision", "function_calling" ]
        },
        // 分组标签：图形处理组、高能力组、推理组、均衡组
        "Groups": [ "图形处理组", "高能力组", "推理组", "均衡组" ]
      },
      "longcat": {
        "BaseUrl": "https://api.longcat.chat/openai/v1",
        "ApiKeyEnvVar": "LONGCAT_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "LongCat-2.0" ],
        // 分组标签：推理组、代码组、均衡组
        "Groups": [ "推理组", "代码组", "均衡组" ]
      },
      "nvidia-nim": {
        "BaseUrl": "https://integrate.api.nvidia.com/v1",
        "ApiKeyEnvVar": "NVIDIA_NIM_API_KEY",
        "TimeoutSeconds": 180,
        "Enabled": true,
        "Models": [ "poolside/laguna-xs-2.1", "nvidia/nemotron-3-ultra-550b-a55b" ],
        // 分组标签：高能力组、推理组
        "Groups": [ "高能力组", "推理组" ]
      },
      "opencode-zen": {
        "BaseUrl": "https://opencode.ai/zen/v1",
        "ApiKeyEnvVar": "OPENCODE_ZEN_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "big-pickle", "nemotron-3-ultra-free", "nemotron-3.5-lightning-free" ],
        // 分组标签：高能力组、推理组、均衡组
        "Groups": [ "高能力组", "推理组", "均衡组" ]
      },
      "openrouter": {
        "BaseUrl": "https://openrouter.ai/api/v1",
        "ApiKeyEnvVar": "OPENROUTER_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "ExtraHeaders": {
          "HTTP-Referer": "https://github.com/opencode",
          "X-Title": "OpenCodeMcpServer"
        },
        "Models": [ "poolside/laguna-s-2.1:free", "nvidia/nemotron-3-ultra-550b-a55b:free", "openrouter/free", "cohere/north-mini-code:free", "nvidia/nemotron-3-super-120b-a12b:free" ],
        // 分组标签：均衡组
        "Groups": [ "均衡组" ]
      },
      "tokenrhythm": {
        "BaseUrl": "https://tokenrhythm.studio/v1",
        "ApiKeyEnvVar": "TOKENRHYTHM_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "qwen3.8-max", "glm-5.3", "deepseek-v4-pro-0813", "glm-5.3-flash", "deepseek-v4-flash-0731", "qwen3.8-27b" ],
        // 分组标签：代码组、推理组、均衡组
        "Groups": [ "代码组", "推理组", "均衡组" ]
      },
      "amd-radeon": {
        "BaseUrl": "https://developer.amd.com.cn/radeon/api/v1",
        "ApiKeyEnvVar": "AMD_RADEON_API_KEY",
        "TimeoutSeconds": 600,
        "Enabled": true,
        "Models": [ "DeepSeek-V4-Flash", "DeepSeek-V4-Flash-Vision-Exp" ],
        "Capabilities": {
          "DeepSeek-V4-Flash": [ "vision" ],
          "DeepSeek-V4-Flash-Vision-Exp": [ "vision" ]
        },
        // 分组标签：图形处理组、高能力组、推理组
        "Groups": [ "图形处理组", "高能力组", "推理组" ]
      },
      "modelscope": {
        "BaseUrl": "https://api-inference.modelscope.cn/v1",
        "ApiKeyEnvVar": "MODELSCOPE_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "ZhipuAI/GLM-5.2", "deepseek-ai/DeepSeek-V4-Pro-0813", "deepseek-ai/DeepSeek-V4-Flash-0731", "deepseek-ai/DeepSeek-V4-Flash", "Qwen/Qwen3.8-27B" ],
        // 分组标签：代码组、推理组、均衡组
        "Groups": [ "代码组", "推理组", "均衡组" ]
      },
      "local": {
        "BaseUrl": "http://localhost:1438/v1",
        "ApiKeyEnvVar": "LOCAL_API_KEY",
        "TimeoutSeconds": 60,
        "Enabled": true,
        "Models": [ "deep" ],
        // 分组标签：均衡组
        "Groups": [ "均衡组" ]
      }
    }
  },

  // ===== 环境变量 Key 配置（运行时注入） =====
  // 推荐通过环境变量注入，不要将 Key 明文写在配置文件中
  // 环境变量前缀: OPENCODE_MCP_
  // 示例: HF_TOKEN=your_hf_token_here
  //       OPENROUTER_API_KEY=your_openrouter_key_here
  //       TOGETHER_API_KEY=your_together_key_here
  //       GROQ_API_KEY=your_groq_key_here
  "ApiKeys": {
    "HF_TOKEN": "",
    "OPENROUTER_API_KEY": "",
    "TOGETHER_API_KEY": "",
    "GROQ_API_KEY": "",
    "ANTHROPIC_API_KEY": "",
    // 自定义提供商密钥：优先级 CustomProviders[providerId] > ApiKeyEnvVar 环境变量
    // 键名必须与 CustomProviders 中的 ProviderId 完全一致（如 "stepfun" 而非 "stepfun_API_KEY"）
    // 环境变量名见各提供商配置的 ApiKeyEnvVar（如 AGNES_CN_API_KEY、STEPFUN_API_KEY 等）
    "CustomProviders": {
    }
  },

  // ===== 提示词管理配置 =====
  "PromptManagement": {
    "Enabled": true,
    "PromptsDirectory": "./prompts",
    "BuiltInCategories": [ "开发", "架构", "AI", "学习", "运维" ],
    "MaxCustomPrompts": 1000,
    "AllowVariableSubstitution": true
  },

  // ===== 技能管理配置 =====
  "SkillManagement": {
    "Enabled": true,
    "SkillsDirectory": "./skills",
    "SkillRegistries": [
      "https://raw.githubusercontent.com/opencode/skill-registry/main/skills.json"
    ],
    "AutoDiscover": true,
    "MaxSkills": 500
  },

  // ===== 缓存配置 =====
  "Cache": {
    "DefaultTtlMinutes": 30,
    "MaxCacheSizeMb": 100,
    "EnableCompression": true
  },

  // ===== 智能路由配置（模块1 预算控制 + 路由策略）=====
  // strategy：默认路由策略 auto=按健康评分自动择优 / sticky=会话粘滞 / balanced=轮询均衡（模块1②实现后生效）
  // maxRetry：单请求最大重试/切换次数（含首选的最高尝试次数 = maxRetry+1）
  // firstTokenTimeoutMs：单次请求首 token 超时毫秒；0 时回退用各提供商端点 TimeoutSeconds
  // totalBudgetMs：整次 chat 请求总预算毫秒（含所有重试）；0 表示不限制
  // retryBackoffMs：失败切换下一提供商前的退避毫秒
  // hotPoolThreshold：热池阈值，健康评分≥此值的可用提供商进入热池优先选用（0-100，模块1③实现）
  // explorationEnabled：热池为空时是否降级探索通道（挑选未达阈值/探测数据不足的候选补数据）
  // modelAlias：固定模型别名，chat_completion 的 model 填此值（或 auto）时按健康评分自动选提供商并发送其默认模型（DefaultModel，缺省回退 Models 首个）
  "Routing": {
    "Strategy": "auto",
    "MaxRetry": 3,
    "FirstTokenTimeoutMs": 60000,
    "TotalBudgetMs": 60000,
    "RetryBackoffMs": 500,
    "HotPoolThreshold": 80,
    "ExplorationEnabled": true,
    "ModelAlias": "SuperModel"
  },

  // ===== OpenAI 兼容 HTTP 网关（固定模型别名 SuperModel，等效 freellmapi 统一 OpenAI 网关）=====
  // enabled：是否启用 Kestrel HTTP 端点；url：监听地址（OpenCode 的 provider baseURL 指向 {url}/v1）
  // apiKey：可选，配置后客户端须带 Authorization: Bearer <apiKey>；
  // includeRealModels：是否把真实提供商模型一并列入 /v1/models
  "HttpServer": {
    "Enabled": true,
    "Url": "http://127.0.0.1:5679",
    "ApiKey": "",
    "IncludeRealModels": false
  },

  // ===== 日志配置 =====
  "Logging": {
    "Level": "Information",
    "EnableFileLogging": true,
    "LogDirectory": "./logs",
    "MaxLogFiles": 10,
    "MaxLogFileSizeMb": 10
  }
}
